// Resume a host .cir module for a HIP target and check that the device binary
// passed to cc1 is attached to the module.
//
// Same path as the CUDA case (CIRGen never runs on a .cir input); the aux-triple
// is what marks the target, so the HIP case is covered separately.
//
// Note: as with CUDA, the registration itself is not emitted on the resume path
// yet, so this test covers the attribute only.

// RUN: echo -n "GPU binary would be here." > %t.fatbin
// RUN: %clang_cc1 -triple x86_64-linux-gnu -aux-triple amdgcn-amd-amdhsa \
// RUN:   -x cir -emit-cir -foffload-include-binary %t.fatbin %s -o - \
// RUN:   | FileCheck %s --check-prefix=ATTR

// RUN: %clang_cc1 -triple x86_64-linux-gnu -aux-triple amdgcn-amd-amdhsa \
// RUN:   -x cir -emit-cir %s -o - | FileCheck %s --check-prefix=NOATTR

module attributes {cir.triple = "x86_64-unknown-linux-gnu"} {
  cir.global external @_Z6kernelv = #cir.ptr<null> : !cir.ptr<!cir.func<()>>
  cir.func @_Z21__device_stub__kernelv() attributes {cu.kernel_name = #cir.cu.kernel_name<"_Z6kernelv">} {
    cir.return
  }
}

// ATTR: cir.cu.device_binary = "GPU binary would be here." : !cir.array<!u8i x 25>

// NOATTR-NOT: cir.cu.device_binary
