// RUN: cir-opt %s -split-input-file \
// RUN:   -pass-pipeline="builtin.module(cir.offload.container(test-print-kernel-bindings))" \
// RUN:   2>&1 | FileCheck %s

// One host stub resolving to one device kernel.
module {
  cir.offload.container {
    builtin.module @host attributes {cir.offload.kind = #cir.offload_kind<host>} {
      cir.func @_Z20__device_stub__scalePff() attributes {cu.kernel_name = #cir.cu.kernel_name<"_Z5scalePff">} {
        cir.return
      }
    }
    builtin.module @device_0 attributes {cir.offload.kind = #cir.offload_kind<device>} {
      cir.func @_Z5scalePff() {
        cir.return
      }
    }
  }
}

// CHECK: KernelBindingTable
// CHECK-NEXT: size 1 empty false
// CHECK-NEXT: kernel _Z5scalePff
// CHECK-NEXT: host-stub @_Z20__device_stub__scalePff
// CHECK-NEXT: device @device_0 : @_Z5scalePff
// CHECK-NEXT: <no launch site>

// -----

// Same kernel present in two device modules (multi-arch).
module {
  cir.offload.container {
    builtin.module @host attributes {cir.offload.kind = #cir.offload_kind<host>} {
      cir.func @_Z20__device_stub__scalePff() attributes {cu.kernel_name = #cir.cu.kernel_name<"_Z5scalePff">} {
        cir.return
      }
    }
    builtin.module @device_0 attributes {cir.offload.kind = #cir.offload_kind<device>} {
      cir.func @_Z5scalePff() {
        cir.return
      }
    }
    builtin.module @device_1 attributes {cir.offload.kind = #cir.offload_kind<device>} {
      cir.func @_Z5scalePff() {
        cir.return
      }
    }
  }
}

// CHECK: KernelBindingTable
// CHECK-NEXT: size 1 empty false
// CHECK-NEXT: kernel _Z5scalePff
// CHECK-NEXT: host-stub @_Z20__device_stub__scalePff
// CHECK-NEXT: device @device_0 : @_Z5scalePff
// CHECK-NEXT: device @device_1 : @_Z5scalePff
// CHECK-NEXT: <no launch site>

// -----

// Host stub whose kernel is absent from every device module.
module {
  cir.offload.container {
    builtin.module @host attributes {cir.offload.kind = #cir.offload_kind<host>} {
      cir.func @_Z19__device_stub__deadv() attributes {cu.kernel_name = #cir.cu.kernel_name<"_Z4deadv">} {
        cir.return
      }
    }
    builtin.module @device_0 attributes {cir.offload.kind = #cir.offload_kind<device>} {
    }
  }
}

// CHECK: KernelBindingTable
// CHECK-NEXT: size 1 empty false
// CHECK-NEXT: kernel _Z4deadv
// CHECK-NEXT: host-stub @_Z19__device_stub__deadv
// CHECK-NEXT: <no device kernel>
// CHECK-NEXT: <no launch site>

// -----

// Near-empty host module (a non-stub helper, no cu.kernel_name) with a
// device-only kernel: nothing binds, table is empty.
module {
  cir.offload.container {
    builtin.module @host attributes {cir.offload.kind = #cir.offload_kind<host>} {
      cir.func @host_helper() {
        cir.return
      }
    }
    builtin.module @device_0 attributes {cir.offload.kind = #cir.offload_kind<device>} {
      cir.func @_Z6devfunv() {
        cir.return
      }
    }
  }
}

// CHECK: KernelBindingTable
// CHECK-NEXT: size 0 empty true

// -----

// Two launches of the same kernel, from different host functions.
!s32i = !cir.int<s, 32>
module {
  cir.offload.container {
    builtin.module @host attributes {cir.offload.kind = #cir.offload_kind<host>} {
      cir.func @_Z18__device_stub__bari(%arg0: !s32i) attributes {cu.kernel_name = #cir.cu.kernel_name<"_Z3bari">} {
        cir.return
      }
      cir.func @launch_a() {
        %0 = cir.const #cir.int<7> : !s32i
        cir.call @_Z18__device_stub__bari(%0) {cu.kernel_name = #cir.cu.kernel_name<"_Z3bari">} : (!s32i) -> ()
        cir.return
      }
      cir.func @launch_b(%arg0: !s32i) {
        cir.call @_Z18__device_stub__bari(%arg0) {cu.kernel_name = #cir.cu.kernel_name<"_Z3bari">} : (!s32i) -> ()
        cir.return
      }
    }
    builtin.module @device_0 attributes {cir.offload.kind = #cir.offload_kind<device>} {
      cir.func @_Z3bari(%arg0: !s32i) {
        cir.return
      }
    }
  }
}

// CHECK: KernelBindingTable
// CHECK-NEXT: size 1 empty false
// CHECK-NEXT: kernel _Z3bari
// CHECK-NEXT: host-stub @_Z18__device_stub__bari
// CHECK-NEXT: device @device_0 : @_Z3bari
// CHECK-NEXT: launch in @launch_a : 1 args
// CHECK-NEXT: launch in @launch_b : 1 args
