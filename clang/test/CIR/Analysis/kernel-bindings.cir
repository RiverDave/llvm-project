// RUN: cir-opt %s -split-input-file \
// RUN:   -pass-pipeline="builtin.module(test-print-kernel-bindings)" \
// RUN:   2>&1 | FileCheck %s

// One host stub resolving to one device kernel.
module attributes {cir.offload.container} {
  module @host attributes {cir.offload.kind = #cir.offload<host>} {
    cir.func @_Z20__device_stub__scalePff() attributes {cu.kernel_name = #cir.cu.kernel_name<"_Z5scalePff">} {
      cir.return
    }
  }
  module @device_0 attributes {cir.offload.kind = #cir.offload<device>} {
    cir.func @_Z5scalePff() {
      cir.return
    }
  }
}

// CHECK: KernelBindingTable
// CHECK-NEXT: size 1 empty false
// CHECK-NEXT: kernel _Z5scalePff
// CHECK-NEXT: host-stub @_Z20__device_stub__scalePff
// CHECK-NEXT: device @device_0 : @_Z5scalePff
// CHECK-NEXT: <no launch site>

// -----

// Same kernel present in two device modules (multi-arch).
module attributes {cir.offload.container} {
  module @host attributes {cir.offload.kind = #cir.offload<host>} {
    cir.func @_Z20__device_stub__scalePff() attributes {cu.kernel_name = #cir.cu.kernel_name<"_Z5scalePff">} {
      cir.return
    }
  }
  module @device_0 attributes {cir.offload.kind = #cir.offload<device>} {
    cir.func @_Z5scalePff() {
      cir.return
    }
  }
  module @device_1 attributes {cir.offload.kind = #cir.offload<device>} {
    cir.func @_Z5scalePff() {
      cir.return
    }
  }
}

// CHECK: KernelBindingTable
// CHECK-NEXT: size 1 empty false
// CHECK-NEXT: kernel _Z5scalePff
// CHECK-NEXT: host-stub @_Z20__device_stub__scalePff
// CHECK-NEXT: device @device_0 : @_Z5scalePff