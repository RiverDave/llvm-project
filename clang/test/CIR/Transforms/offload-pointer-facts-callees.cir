// RUN: cir-opt %s -split-input-file \
// RUN:   -pass-pipeline="builtin.module(cir-offload-pointer-facts)" | FileCheck %s

// Everything the kernel can call runs during the launch, so callees are checked
// with the same rules as the kernel body.

// A callee writes a kernel buffer through a device global.
// CHECK-LABEL: cir.func @k(
// CHECK-NOT: llvm.noalias
// CHECK-SAME: cc(ptx_kernel)
!s32i = !cir.int<s, 32>
!u64i = !cir.int<u, 64>
!void = !cir.void
module attributes {cir.offload.container} {
  builtin.module @host attributes {cir.offload.kind = #cir.offload<host>} {
    cir.func private @cudaMalloc(!cir.ptr<!cir.ptr<!void>>, !u64i) -> !s32i
    cir.func internal private @stub(%arg0: !cir.ptr<!cir.float>, %arg1: !cir.ptr<!cir.float>) attributes {cu.kernel_name = #cir.cu.kernel_name<"k">} {
      cir.return
    }
    cir.func @launch() {
      %a = cir.alloca "a" align(8) : !cir.ptr<!cir.ptr<!cir.float>>
      %b = cir.alloca "b" align(8) : !cir.ptr<!cir.ptr<!cir.float>>
      %sz = cir.const #cir.int<16> : !u64i
      %ca = cir.cast bitcast %a : !cir.ptr<!cir.ptr<!cir.float>> -> !cir.ptr<!cir.ptr<!void>>
      %ea = cir.call @cudaMalloc(%ca, %sz) : (!cir.ptr<!cir.ptr<!void>>, !u64i) -> !s32i
      %cb = cir.cast bitcast %b : !cir.ptr<!cir.ptr<!cir.float>> -> !cir.ptr<!cir.ptr<!void>>
      %eb = cir.call @cudaMalloc(%cb, %sz) : (!cir.ptr<!cir.ptr<!void>>, !u64i) -> !s32i
      %pa = cir.load %a : !cir.ptr<!cir.ptr<!cir.float>>, !cir.ptr<!cir.float>
      %pb = cir.load %b : !cir.ptr<!cir.ptr<!cir.float>>, !cir.ptr<!cir.float>
      cir.call @stub(%pa, %pb) {cu.kernel_name = #cir.cu.kernel_name<"k">} : (!cir.ptr<!cir.float>, !cir.ptr<!cir.float>) -> ()
      cir.return
    }
  }
  builtin.module @device_0 attributes {cir.offload.kind = #cir.offload<device>} {
    cir.global external @g_ptr = #cir.ptr<null> : !cir.ptr<!cir.float>
    cir.func no_inline @bump() {
      %g = cir.get_global @g_ptr : !cir.ptr<!cir.ptr<!cir.float>>
      %p = cir.load %g : !cir.ptr<!cir.ptr<!cir.float>>, !cir.ptr<!cir.float>
      %two = cir.const #cir.fp<2.0> : !cir.float
      cir.store %two, %p : !cir.float, !cir.ptr<!cir.float>
      cir.return
    }
    cir.func @k(%arg0: !cir.ptr<!cir.float>, %arg1: !cir.ptr<!cir.float>) cc(ptx_kernel) {
      %one = cir.const #cir.fp<1.0> : !cir.float
      cir.store %one, %arg1 : !cir.float, !cir.ptr<!cir.float>
      cir.call @bump() : () -> ()
      cir.return
    }
  }
}

// -----

// A callee whose body only reads thread geometry keeps the fact.
// CHECK-LABEL: cir.func @k(%arg0: !cir.ptr<!cir.float> {llvm.noalias}, %arg1: !cir.ptr<!cir.float> {llvm.noalias})
!s32i = !cir.int<s, 32>
!u64i = !cir.int<u, 64>
!void = !cir.void
module attributes {cir.offload.container} {
  builtin.module @host attributes {cir.offload.kind = #cir.offload<host>} {
    cir.func private @cudaMalloc(!cir.ptr<!cir.ptr<!void>>, !u64i) -> !s32i
    cir.func internal private @stub(%arg0: !cir.ptr<!cir.float>, %arg1: !cir.ptr<!cir.float>) attributes {cu.kernel_name = #cir.cu.kernel_name<"k">} {
      cir.return
    }
    cir.func @launch() {
      %a = cir.alloca "a" align(8) : !cir.ptr<!cir.ptr<!cir.float>>
      %b = cir.alloca "b" align(8) : !cir.ptr<!cir.ptr<!cir.float>>
      %sz = cir.const #cir.int<16> : !u64i
      %ca = cir.cast bitcast %a : !cir.ptr<!cir.ptr<!cir.float>> -> !cir.ptr<!cir.ptr<!void>>
      %ea = cir.call @cudaMalloc(%ca, %sz) : (!cir.ptr<!cir.ptr<!void>>, !u64i) -> !s32i
      %cb = cir.cast bitcast %b : !cir.ptr<!cir.ptr<!cir.float>> -> !cir.ptr<!cir.ptr<!void>>
      %eb = cir.call @cudaMalloc(%cb, %sz) : (!cir.ptr<!cir.ptr<!void>>, !u64i) -> !s32i
      %pa = cir.load %a : !cir.ptr<!cir.ptr<!cir.float>>, !cir.ptr<!cir.float>
      %pb = cir.load %b : !cir.ptr<!cir.ptr<!cir.float>>, !cir.ptr<!cir.float>
      cir.call @stub(%pa, %pb) {cu.kernel_name = #cir.cu.kernel_name<"k">} : (!cir.ptr<!cir.float>, !cir.ptr<!cir.float>) -> ()
      cir.return
    }
  }
  builtin.module @device_0 attributes {cir.offload.kind = #cir.offload<device>} {
    cir.func no_inline @tid() -> !s32i {
      %t = cir.call_llvm_intrinsic "nvvm.read.ptx.sreg.tid.x"  : () -> !s32i
      cir.return %t : !s32i
    }
    cir.func @k(%arg0: !cir.ptr<!cir.float>, %arg1: !cir.ptr<!cir.float>) cc(ptx_kernel) {
      %t = cir.call @tid() : () -> !s32i
      cir.return
    }
  }
}

// -----

// A libdevice declaration is known not to touch kernel buffers.
// CHECK-LABEL: cir.func @k(%arg0: !cir.ptr<!cir.float> {llvm.noalias}, %arg1: !cir.ptr<!cir.float> {llvm.noalias})
!s32i = !cir.int<s, 32>
!u64i = !cir.int<u, 64>
!void = !cir.void
module attributes {cir.offload.container} {
  builtin.module @host attributes {cir.offload.kind = #cir.offload<host>} {
    cir.func private @cudaMalloc(!cir.ptr<!cir.ptr<!void>>, !u64i) -> !s32i
    cir.func internal private @stub(%arg0: !cir.ptr<!cir.float>, %arg1: !cir.ptr<!cir.float>) attributes {cu.kernel_name = #cir.cu.kernel_name<"k">} {
      cir.return
    }
    cir.func @launch() {
      %a = cir.alloca "a" align(8) : !cir.ptr<!cir.ptr<!cir.float>>
      %b = cir.alloca "b" align(8) : !cir.ptr<!cir.ptr<!cir.float>>
      %sz = cir.const #cir.int<16> : !u64i
      %ca = cir.cast bitcast %a : !cir.ptr<!cir.ptr<!cir.float>> -> !cir.ptr<!cir.ptr<!void>>
      %ea = cir.call @cudaMalloc(%ca, %sz) : (!cir.ptr<!cir.ptr<!void>>, !u64i) -> !s32i
      %cb = cir.cast bitcast %b : !cir.ptr<!cir.ptr<!cir.float>> -> !cir.ptr<!cir.ptr<!void>>
      %eb = cir.call @cudaMalloc(%cb, %sz) : (!cir.ptr<!cir.ptr<!void>>, !u64i) -> !s32i
      %pa = cir.load %a : !cir.ptr<!cir.ptr<!cir.float>>, !cir.ptr<!cir.float>
      %pb = cir.load %b : !cir.ptr<!cir.ptr<!cir.float>>, !cir.ptr<!cir.float>
      cir.call @stub(%pa, %pb) {cu.kernel_name = #cir.cu.kernel_name<"k">} : (!cir.ptr<!cir.float>, !cir.ptr<!cir.float>) -> ()
      cir.return
    }
  }
  builtin.module @device_0 attributes {cir.offload.kind = #cir.offload<device>} {
    cir.func private @__nv_sqrtf(!cir.float) -> !cir.float
    cir.func @k(%arg0: !cir.ptr<!cir.float>, %arg1: !cir.ptr<!cir.float>) cc(ptx_kernel) {
      %x = cir.const #cir.fp<4.0> : !cir.float
      %r = cir.call @__nv_sqrtf(%x) : (!cir.float) -> !cir.float
      cir.return
    }
  }
}

