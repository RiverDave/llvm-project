module attributes {cir.offload.container} {
  builtin.module @host attributes {cir.offload.kind = #cir.offload<host>} {
    cir.func private @cudaMalloc(!cir.ptr<!cir.ptr<!void>>, !u64i) -> !s32i
    cir.func internal private @stub(%arg0: !cir.ptr<!cir.float>, %arg1: !cir.ptr<!cir.float>) attributes {cu.kernel_name = #cir.cu.kernel_name<"k">} {
      cir.return
    }
    cir.func @launch() {
      %a = cir.alloca "a" align(8) : !cir.ptr<!cir.ptr<!cir.float>>
      %b = cir.alloca "b" align(8) : !cir.ptr<!cir.ptr<!cir.float>>
