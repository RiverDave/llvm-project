// RUN: cir-opt %s -split-input-file \
// RUN:   -pass-pipeline="builtin.module(cir.offload.container(cir-offload-launch-noalias))" \
// RUN:   2>%t.err | FileCheck %s
// RUN: FileCheck %s --allow-empty --check-prefix=NOERR --input-file=%t.err
// NOERR-NOT: {{.}}

//===----------------------------------------------------------------------===//
// Positives: fully proven launches receive llvm.noalias.
//===----------------------------------------------------------------------===//

// A checked cudaMalloc allocation, compared against the cudaSuccess global,
// keeps the fact on the single pointer parameter.
// CHECK-LABEL: cir.func @kern_pos(
// CHECK: llvm.noalias
!s32i = !cir.int<s, 32>
!u64i = !cir.int<u, 64>
!void = !cir.void
module {
  cir.offload.container {
    builtin.module @host attributes {cir.offload.kind = #cir.offload_kind<host>} {
      cir.func private @cudaMalloc(!cir.ptr<!cir.ptr<!void>>, !u64i) -> !s32i
      cir.global external @cudaSuccess = #cir.int<0> : !s32i
      cir.func internal private @stub_pos(%arg0: !cir.ptr<!s32i>) attributes {cu.kernel_name = #cir.cu.kernel_name<"kern_pos">} {
        cir.return
      }
      cir.func @launch_pos() {
        %slot = cir.alloca "p" align(8) init : !cir.ptr<!cir.ptr<!s32i>>
        %null = cir.const #cir.ptr<null> : !cir.ptr<!s32i>
        cir.store align(8) %null, %slot : !cir.ptr<!s32i>, !cir.ptr<!cir.ptr<!s32i>>
        %cast = cir.cast bitcast %slot : !cir.ptr<!cir.ptr<!s32i>> -> !cir.ptr<!cir.ptr<!void>>
        %size = cir.const #cir.int<16> : !u64i
        %err = cir.call @cudaMalloc(%cast, %size) : (!cir.ptr<!cir.ptr<!void>>, !u64i) -> !s32i
        %success = cir.get_global @cudaSuccess : !cir.ptr<!s32i>
        %sv = cir.load %success : !cir.ptr<!s32i>, !s32i
        %fail = cir.cmp ne %err, %sv : !s32i
        cir.if %fail {
          cir.return
        }
        %p = cir.load align(8) %slot : !cir.ptr<!cir.ptr<!s32i>>, !cir.ptr<!s32i>
        cir.call @stub_pos(%p) {cu.kernel_name = #cir.cu.kernel_name<"kern_pos">} : (!cir.ptr<!s32i>) -> ()
        cir.return
      }
    }
    builtin.module @device_0 attributes {cir.offload.kind = #cir.offload_kind<device>} {
      cir.func @kern_pos(%arg0: !cir.ptr<!s32i>) cc(ptx_kernel) {
        cir.return
      }
    }
  }
}

// -----

// Two launches, each with two distinct fully proven roots: the meet stamps
// both pointer parameters kernel-wide.
// CHECK-LABEL: cir.func @kern_two(
// CHECK: llvm.noalias
// CHECK: %arg1: !cir.ptr<!cir.float> {llvm.noalias}
!s32i = !cir.int<s, 32>
!u64i = !cir.int<u, 64>
!void = !cir.void
module {
  cir.offload.container {
    builtin.module @host attributes {cir.offload.kind = #cir.offload_kind<host>} {
      cir.func private @cudaMalloc(!cir.ptr<!cir.ptr<!void>>, !u64i) -> !s32i
      cir.func internal private @stub_two(%arg0: !cir.ptr<!s32i>, %arg1: !cir.ptr<!cir.float>) attributes {cu.kernel_name = #cir.cu.kernel_name<"kern_two">} {
        cir.return
      }
      cir.func @launch_two_a() {
        %a = cir.alloca "a" align(8) init : !cir.ptr<!cir.ptr<!s32i>>
        %b = cir.alloca "b" align(8) init : !cir.ptr<!cir.ptr<!cir.float>>
        %ac = cir.cast bitcast %a : !cir.ptr<!cir.ptr<!s32i>> -> !cir.ptr<!cir.ptr<!void>>
        %bc = cir.cast bitcast %b : !cir.ptr<!cir.ptr<!cir.float>> -> !cir.ptr<!cir.ptr<!void>>
        %s1 = cir.const #cir.int<16> : !u64i
        %e1 = cir.call @cudaMalloc(%ac, %s1) : (!cir.ptr<!cir.ptr<!void>>, !u64i) -> !s32i
        %s2 = cir.const #cir.int<16> : !u64i
        %e2 = cir.call @cudaMalloc(%bc, %s2) : (!cir.ptr<!cir.ptr<!void>>, !u64i) -> !s32i
        %zero = cir.const #cir.int<0> : !s32i
        %f1 = cir.cmp ne %e1, %zero : !s32i
        %f2 = cir.cmp ne %e2, %zero : !s32i
        cir.if %f1 {
          cir.return
        }
        cir.if %f2 {
          cir.return
        }
        %av = cir.load align(8) %a : !cir.ptr<!cir.ptr<!s32i>>, !cir.ptr<!s32i>
        %bv = cir.load align(8) %b : !cir.ptr<!cir.ptr<!cir.float>>, !cir.ptr<!cir.float>
        cir.call @stub_two(%av, %bv) {cu.kernel_name = #cir.cu.kernel_name<"kern_two">} : (!cir.ptr<!s32i>, !cir.ptr<!cir.float>) -> ()
        cir.return
      }
      cir.func @launch_two_b() {
        %c = cir.alloca "c" align(8) init : !cir.ptr<!cir.ptr<!s32i>>
        %d = cir.alloca "d" align(8) init : !cir.ptr<!cir.ptr<!cir.float>>
        %cc = cir.cast bitcast %c : !cir.ptr<!cir.ptr<!s32i>> -> !cir.ptr<!cir.ptr<!void>>
        %dc = cir.cast bitcast %d : !cir.ptr<!cir.ptr<!cir.float>> -> !cir.ptr<!cir.ptr<!void>>
        %s3 = cir.const #cir.int<16> : !u64i
        %e3 = cir.call @cudaMalloc(%cc, %s3) : (!cir.ptr<!cir.ptr<!void>>, !u64i) -> !s32i
        %s4 = cir.const #cir.int<16> : !u64i
        %e4 = cir.call @cudaMalloc(%dc, %s4) : (!cir.ptr<!cir.ptr<!void>>, !u64i) -> !s32i
        %zero = cir.const #cir.int<0> : !s32i
        %f3 = cir.cmp ne %e3, %zero : !s32i
        %f4 = cir.cmp ne %e4, %zero : !s32i
        cir.if %f3 {
          cir.return
        }
        cir.if %f4 {
          cir.return
        }
        %cv = cir.load align(8) %c : !cir.ptr<!cir.ptr<!s32i>>, !cir.ptr<!s32i>
        %dv = cir.load align(8) %d : !cir.ptr<!cir.ptr<!cir.float>>, !cir.ptr<!cir.float>
        cir.call @stub_two(%cv, %dv) {cu.kernel_name = #cir.cu.kernel_name<"kern_two">} : (!cir.ptr<!s32i>, !cir.ptr<!cir.float>) -> ()
        cir.return
      }
    }
    builtin.module @device_0 attributes {cir.offload.kind = #cir.offload_kind<device>} {
      cir.func @kern_two(%arg0: !cir.ptr<!s32i>, %arg1: !cir.ptr<!cir.float>) cc(ptx_kernel) {
        cir.return
      }
    }
  }
}

// -----

// A staging slot with a single dominating store forwards the cudaMalloc root.
// CHECK-LABEL: cir.func @kern_store(
// CHECK: llvm.noalias
!s32i = !cir.int<s, 32>
!u64i = !cir.int<u, 64>
!void = !cir.void
module {
  cir.offload.container {
    builtin.module @host attributes {cir.offload.kind = #cir.offload_kind<host>} {
      cir.func private @cudaMalloc(!cir.ptr<!cir.ptr<!void>>, !u64i) -> !s32i
      cir.func internal private @stub_store(%arg0: !cir.ptr<!s32i>) attributes {cu.kernel_name = #cir.cu.kernel_name<"kern_store">} {
        cir.return
      }
      cir.func @launch_store() {
        %slot = cir.alloca "p" align(8) init : !cir.ptr<!cir.ptr<!s32i>>
        %stage = cir.alloca "stage" align(8) : !cir.ptr<!cir.ptr<!s32i>>
        %cast = cir.cast bitcast %slot : !cir.ptr<!cir.ptr<!s32i>> -> !cir.ptr<!cir.ptr<!void>>
        %size = cir.const #cir.int<16> : !u64i
        %err = cir.call @cudaMalloc(%cast, %size) : (!cir.ptr<!cir.ptr<!void>>, !u64i) -> !s32i
        %zero = cir.const #cir.int<0> : !s32i
        %fail = cir.cmp ne %err, %zero : !s32i
        cir.if %fail {
          cir.return
        }
        %v = cir.load align(8) %slot : !cir.ptr<!cir.ptr<!s32i>>, !cir.ptr<!s32i>
        cir.store align(8) %v, %stage : !cir.ptr<!s32i>, !cir.ptr<!cir.ptr<!s32i>>
        %p = cir.load align(8) %stage : !cir.ptr<!cir.ptr<!s32i>>, !cir.ptr<!s32i>
        cir.call @stub_store(%p) {cu.kernel_name = #cir.cu.kernel_name<"kern_store">} : (!cir.ptr<!s32i>) -> ()
        cir.return
      }
    }
    builtin.module @device_0 attributes {cir.offload.kind = #cir.offload_kind<device>} {
      cir.func @kern_store(%arg0: !cir.ptr<!s32i>) cc(ptx_kernel) {
        cir.return
      }
    }
  }
}

//===----------------------------------------------------------------------===//
// Negatives: kernel-wide suppression, checked by the absence of llvm.noalias.
//===----------------------------------------------------------------------===//

