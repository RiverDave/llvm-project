      cir.func @launch_inval() {
        %slot = cir.alloca "p" align(8) init : !cir.ptr<!cir.ptr<!s32i>>
        %zero = cir.const #cir.int<0> : !s32i
        %cast1 = cir.cast bitcast %slot : !cir.ptr<!cir.ptr<!s32i>> -> !cir.ptr<!cir.ptr<!void>>
        %s1 = cir.const #cir.int<16> : !u64i
        %e1 = cir.call @cudaMalloc(%cast1, %s1) : (!cir.ptr<!cir.ptr<!void>>, !u64i) -> !s32i
        %f1 = cir.cmp ne %e1, %zero : !s32i
        cir.if %f1 {
          cir.return
        }
        %cast2 = cir.cast bitcast %slot : !cir.ptr<!cir.ptr<!s32i>> -> !cir.ptr<!cir.ptr<!void>>
        %s2 = cir.const #cir.int<32> : !u64i
        %e2 = cir.call @cudaMalloc(%cast2, %s2) : (!cir.ptr<!cir.ptr<!void>>, !u64i) -> !s32i
        %f2 = cir.cmp ne %e2, %zero : !s32i
        cir.if %f2 {
          cir.return
        }
        %p = cir.load align(8) %slot : !cir.ptr<!cir.ptr<!s32i>>, !cir.ptr<!s32i>
        cir.call @stub_inval(%p) {cu.kernel_name = #cir.cu.kernel_name<"kern_inval">} : (!cir.ptr<!s32i>) -> ()
        cir.return
      }
    }
    builtin.module @device_0 attributes {cir.offload.kind = #cir.offload_kind<device>} {
      cir.func @kern_inval(%arg0: !cir.ptr<!s32i>) cc(ptx_kernel) {
        cir.return
      }
    }
  }
}

