// The slot is reallocated after the checked allocation.
// CHECK-LABEL: cir.func @kern_inval(
// CHECK-NOT: llvm.noalias
// CHECK: cc(ptx_kernel)
!s32i = !cir.int<s, 32>
!u64i = !cir.int<u, 64>
!void = !cir.void
