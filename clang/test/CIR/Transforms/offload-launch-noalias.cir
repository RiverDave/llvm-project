        %cast = cir.cast bitcast %slot : !cir.ptr<!cir.ptr<!s32i>> -> !cir.ptr<!cir.ptr<!void>>
        %size = cir.const #cir.int<16> : !u64i
        %err = cir.call @cudaMalloc(%cast, %size) : (!cir.ptr<!cir.ptr<!void>>, !u64i) -> !s32i
        %zero = cir.const #cir.int<0> : !s32i
        %fail = cir.cmp ne %err, %zero : !s32i
        cir.if %fail {
          cir.return
        }
        %p = cir.load align(8) %slot : !cir.ptr<!cir.ptr<!s32i>>, !cir.ptr<!s32i>
        cir.call @stub_same(%p, %p) {cu.kernel_name = #cir.cu.kernel_name<"kern_same">} : (!cir.ptr<!s32i>, !cir.ptr<!s32i>) -> ()
        cir.return
      }
    }
    builtin.module @device_0 attributes {cir.offload.kind = #cir.offload_kind<device>} {
      cir.func @kern_same(%arg0: !cir.ptr<!s32i>, %arg1: !cir.ptr<!s32i>) cc(ptx_kernel) {
        cir.return
      }
    }
  }
}

// -----

// One launch among several passes an untraceable host argument.
// CHECK-LABEL: cir.func @kern_bad(
// CHECK-NOT: llvm.noalias
// CHECK: cc(ptx_kernel)
!s32i = !cir.int<s, 32>
!u64i = !cir.int<u, 64>
!void = !cir.void
module {
  cir.offload.container {
    builtin.module @host attributes {cir.offload.kind = #cir.offload_kind<host>} {
      cir.func private @cudaMalloc(!cir.ptr<!cir.ptr<!void>>, !u64i) -> !s32i
      cir.func internal private @stub_bad(%arg0: !cir.ptr<!s32i>, %arg1: !cir.ptr<!s32i>) attributes {cu.kernel_name = #cir.cu.kernel_name<"kern_bad">} {
        cir.return
      }
      cir.func @launch_bad_a() {
        %a = cir.alloca "a" align(8) init : !cir.ptr<!cir.ptr<!s32i>>
        %b = cir.alloca "b" align(8) init : !cir.ptr<!cir.ptr<!s32i>>
        %ac = cir.cast bitcast %a : !cir.ptr<!cir.ptr<!s32i>> -> !cir.ptr<!cir.ptr<!void>>
        %bc = cir.cast bitcast %b : !cir.ptr<!cir.ptr<!s32i>> -> !cir.ptr<!cir.ptr<!void>>
        %s1 = cir.const #cir.int<16> : !u64i
        %e1 = cir.call @cudaMalloc(%ac, %s1) : (!cir.ptr<!cir.ptr<!void>>, !u64i) -> !s32i
        %s2 = cir.const #cir.int<16> : !u64i
        %e2 = cir.call @cudaMalloc(%bc, %s2) : (!cir.ptr<!cir.ptr<!void>>, !u64i) -> !s32i
        %zero = cir.const #cir.int<0> : !s32i
        %f1 = cir.cmp ne %e1, %zero : !s32i
        %f2 = cir.cmp ne %e2, %zero : !s32i
        cir.if %f1 {
          cir.return
        }
        cir.if %f2 {
          cir.return
        }
        %av = cir.load align(8) %a : !cir.ptr<!cir.ptr<!s32i>>, !cir.ptr<!s32i>
        %bv = cir.load align(8) %b : !cir.ptr<!cir.ptr<!s32i>>, !cir.ptr<!s32i>
        cir.call @stub_bad(%av, %bv) {cu.kernel_name = #cir.cu.kernel_name<"kern_bad">} : (!cir.ptr<!s32i>, !cir.ptr<!s32i>) -> ()
        cir.return
      }
      cir.func @launch_bad_b(%in: !cir.ptr<!s32i>) {
        %b = cir.alloca "b" align(8) init : !cir.ptr<!cir.ptr<!s32i>>
        %bc = cir.cast bitcast %b : !cir.ptr<!cir.ptr<!s32i>> -> !cir.ptr<!cir.ptr<!void>>
        %s = cir.const #cir.int<16> : !u64i
        %e = cir.call @cudaMalloc(%bc, %s) : (!cir.ptr<!cir.ptr<!void>>, !u64i) -> !s32i
        %zero = cir.const #cir.int<0> : !s32i
        %f = cir.cmp ne %e, %zero : !s32i
        cir.if %f {
          cir.return
        }
        %bv = cir.load align(8) %b : !cir.ptr<!cir.ptr<!s32i>>, !cir.ptr<!s32i>
        cir.call @stub_bad(%in, %bv) {cu.kernel_name = #cir.cu.kernel_name<"kern_bad">} : (!cir.ptr<!s32i>, !cir.ptr<!s32i>) -> ()
        cir.return
      }
    }
    builtin.module @device_0 attributes {cir.offload.kind = #cir.offload_kind<device>} {
      cir.func @kern_bad(%arg0: !cir.ptr<!s32i>, %arg1: !cir.ptr<!s32i>) cc(ptx_kernel) {
        cir.return
      }
    }
  }
}

// -----

// A store into the slot after cudaMalloc is a second writer.
// CHECK-LABEL: cir.func @kern_writer(
// CHECK-NOT: llvm.noalias
// CHECK: cc(ptx_kernel)
!s32i = !cir.int<s, 32>
!u64i = !cir.int<u, 64>
!void = !cir.void
module {
  cir.offload.container {
    builtin.module @host attributes {cir.offload.kind = #cir.offload_kind<host>} {
      cir.func private @cudaMalloc(!cir.ptr<!cir.ptr<!void>>, !u64i) -> !s32i
      cir.func internal private @stub_writer(%arg0: !cir.ptr<!s32i>) attributes {cu.kernel_name = #cir.cu.kernel_name<"kern_writer">} {
        cir.return
      }
      cir.func @launch_writer() {
        %slot = cir.alloca "p" align(8) init : !cir.ptr<!cir.ptr<!s32i>>
        %cast = cir.cast bitcast %slot : !cir.ptr<!cir.ptr<!s32i>> -> !cir.ptr<!cir.ptr<!void>>
        %size = cir.const #cir.int<16> : !u64i
        %err = cir.call @cudaMalloc(%cast, %size) : (!cir.ptr<!cir.ptr<!void>>, !u64i) -> !s32i
        %zero = cir.const #cir.int<0> : !s32i
        %fail = cir.cmp ne %err, %zero : !s32i
        cir.if %fail {
          cir.return
        }
        %null = cir.const #cir.ptr<null> : !cir.ptr<!s32i>
        cir.store align(8) %null, %slot : !cir.ptr<!s32i>, !cir.ptr<!cir.ptr<!s32i>>
        %p = cir.load align(8) %slot : !cir.ptr<!cir.ptr<!s32i>>, !cir.ptr<!s32i>
        cir.call @stub_writer(%p) {cu.kernel_name = #cir.cu.kernel_name<"kern_writer">} : (!cir.ptr<!s32i>) -> ()
        cir.return
      }
    }
    builtin.module @device_0 attributes {cir.offload.kind = #cir.offload_kind<device>} {
      cir.func @kern_writer(%arg0: !cir.ptr<!s32i>) cc(ptx_kernel) {
        cir.return
      }
    }
  }
}

