// The kernel forwards a pointer parameter to an unknown callee.
// CHECK-LABEL: cir.func @kern_unknown(
// CHECK-NOT: llvm.noalias
// CHECK: cc(ptx_kernel)
!s32i = !cir.int<s, 32>
!u64i = !cir.int<u, 64>
!void = !cir.void
module {
  cir.offload.container {
    builtin.module @host attributes {cir.offload.kind = #cir.offload_kind<host>} {
      cir.func private @cudaMalloc(!cir.ptr<!cir.ptr<!void>>, !u64i) -> !s32i
      cir.func internal private @stub_unknown(%arg0: !cir.ptr<!s32i>) attributes {cu.kernel_name = #cir.cu.kernel_name<"kern_unknown">} {
        cir.return
      }
      cir.func @launch_unknown() {
        %slot = cir.alloca "p" align(8) init : !cir.ptr<!cir.ptr<!s32i>>
        %cast = cir.cast bitcast %slot : !cir.ptr<!cir.ptr<!s32i>> -> !cir.ptr<!cir.ptr<!void>>
        %size = cir.const #cir.int<16> : !u64i
        %err = cir.call @cudaMalloc(%cast, %size) : (!cir.ptr<!cir.ptr<!void>>, !u64i) -> !s32i
        %zero = cir.const #cir.int<0> : !s32i
        %fail = cir.cmp ne %err, %zero : !s32i
        cir.if %fail {
          cir.return
        }
        %p = cir.load align(8) %slot : !cir.ptr<!cir.ptr<!s32i>>, !cir.ptr<!s32i>
        cir.call @stub_unknown(%p) {cu.kernel_name = #cir.cu.kernel_name<"kern_unknown">} : (!cir.ptr<!s32i>) -> ()
        cir.return
      }
    }
    builtin.module @device_0 attributes {cir.offload.kind = #cir.offload_kind<device>} {
      cir.func private @unknown_callee(!cir.ptr<!s32i>)
      cir.func @kern_unknown(%arg0: !cir.ptr<!s32i>) cc(ptx_kernel) {
        cir.call @unknown_callee(%arg0) : (!cir.ptr<!s32i>) -> ()
        cir.return
      }
    }
  }
}

// -----

// A visible wrapper is still a callee: forwarding disqualifies without
// inspecting the wrapper body.
// CHECK-LABEL: cir.func @kern_wrapper(
// CHECK-NOT: llvm.noalias
// CHECK: cc(ptx_kernel)
!s32i = !cir.int<s, 32>
!u64i = !cir.int<u, 64>
!void = !cir.void
module {
  cir.offload.container {
    builtin.module @host attributes {cir.offload.kind = #cir.offload_kind<host>} {
      cir.func private @cudaMalloc(!cir.ptr<!cir.ptr<!void>>, !u64i) -> !s32i
      cir.func internal private @stub_wrapper(%arg0: !cir.ptr<!s32i>) attributes {cu.kernel_name = #cir.cu.kernel_name<"kern_wrapper">} {
        cir.return
      }
      cir.func @launch_wrapper() {
        %slot = cir.alloca "p" align(8) init : !cir.ptr<!cir.ptr<!s32i>>
        %cast = cir.cast bitcast %slot : !cir.ptr<!cir.ptr<!s32i>> -> !cir.ptr<!cir.ptr<!void>>
        %size = cir.const #cir.int<16> : !u64i
        %err = cir.call @cudaMalloc(%cast, %size) : (!cir.ptr<!cir.ptr<!void>>, !u64i) -> !s32i
        %zero = cir.const #cir.int<0> : !s32i
        %fail = cir.cmp ne %err, %zero : !s32i
        cir.if %fail {
          cir.return
        }
        %p = cir.load align(8) %slot : !cir.ptr<!cir.ptr<!s32i>>, !cir.ptr<!s32i>
        cir.call @stub_wrapper(%p) {cu.kernel_name = #cir.cu.kernel_name<"kern_wrapper">} : (!cir.ptr<!s32i>) -> ()
        cir.return
      }
    }
    builtin.module @device_0 attributes {cir.offload.kind = #cir.offload_kind<device>} {
      cir.func internal @visible_wrapper(%arg0: !cir.ptr<!s32i>) {
        cir.return
      }
      cir.func @kern_wrapper(%arg0: !cir.ptr<!s32i>) cc(ptx_kernel) {
        cir.call @visible_wrapper(%arg0) : (!cir.ptr<!s32i>) -> ()
        cir.return
      }
    }
  }
}
