// The slot address escapes into another slot.
// CHECK-LABEL: cir.func @kern_escape(
// CHECK-NOT: llvm.noalias
// CHECK: cc(ptx_kernel)
!s32i = !cir.int<s, 32>
!u64i = !cir.int<u, 64>
!void = !cir.void
module {
  cir.offload.container {
    builtin.module @host attributes {cir.offload.kind = #cir.offload_kind<host>} {
      cir.func private @cudaMalloc(!cir.ptr<!cir.ptr<!void>>, !u64i) -> !s32i
      cir.func private @escape_helper(!cir.ptr<!cir.ptr<!void>>)
      cir.func internal private @stub_escape(%arg0: !cir.ptr<!s32i>) attributes {cu.kernel_name = #cir.cu.kernel_name<"kern_escape">} {
        cir.return
      }
      cir.func @launch_escape() {
        %slot = cir.alloca "p" align(8) init : !cir.ptr<!cir.ptr<!s32i>>
        %cast = cir.cast bitcast %slot : !cir.ptr<!cir.ptr<!s32i>> -> !cir.ptr<!cir.ptr<!void>>
        %size = cir.const #cir.int<16> : !u64i
        %err = cir.call @cudaMalloc(%cast, %size) : (!cir.ptr<!cir.ptr<!void>>, !u64i) -> !s32i
        %zero = cir.const #cir.int<0> : !s32i
        %fail = cir.cmp ne %err, %zero : !s32i
        cir.if %fail {
          cir.return
        }
        cir.call @escape_helper(%cast) : (!cir.ptr<!cir.ptr<!void>>) -> ()
        %p = cir.load align(8) %slot : !cir.ptr<!cir.ptr<!s32i>>, !cir.ptr<!s32i>
        cir.call @stub_escape(%p) {cu.kernel_name = #cir.cu.kernel_name<"kern_escape">} : (!cir.ptr<!s32i>) -> ()
        cir.return
      }
    }
    builtin.module @device_0 attributes {cir.offload.kind = #cir.offload_kind<device>} {
      cir.func @kern_escape(%arg0: !cir.ptr<!s32i>) cc(ptx_kernel) {
        cir.return
      }
    }
  }
}

